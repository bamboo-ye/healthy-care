FROM pgvector/pgvector:0.8.2-pg17@sha256:feb68f4f15446397d8cac7f4fe48fe4586de83160d1fc48b46283312d1a33966
COPY deploy/backup /opt/backup
RUN mkdir -p /backups && chown 10001:10001 /backups && chmod 0700 /backups && chmod 0644 /opt/backup/*
USER 10001:10001
ENTRYPOINT ["/bin/sh", "/opt/backup/loop.sh"]
