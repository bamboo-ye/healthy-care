{
 email {$TLS_EMAIL}
}
{$APP_DOMAIN} {
 encode zstd gzip
 header {
  X-Content-Type-Options nosniff
  Referrer-Policy same-origin
  X-Frame-Options DENY
  Strict-Transport-Security "max-age=31536000"
  Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
 }
 handle /v1/* {
  reverse_proxy api:8080 {
   flush_interval -1
  }
 }
 @health path /healthz /readyz
 handle @health {
  reverse_proxy api:8080
 }
 handle {
  root * /srv
  try_files {path} {path}/index.html /index.html
  file_server
 }
}
